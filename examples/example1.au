print("Approximating 'e' number with a Taylor series")
print("e = 1 + 1/1! + 1/2! + 1/3! + ...")

e = 2
term = 1

term = term * 2
e = e + 1/term
term = term * 3
e = e + 1/term
term = term * 4
e = e + 1/term
term = term * 5
e = e + 1/term
term = term * 6
e = e + 1/term
term = term * 7
e = e + 1/term
term = term * 8
e = e + 1/term

print("Approximation with 8 terms:")
print(e)

real = 2.718281
print("Absolute error:")
print(abs(real - e))